extends ../layouts/default.pug

block main
  - const colorIdx = deck.category_id % 8

  .form-container

    .page-header
      .page-title Chỉnh sửa bộ thẻ

    .form-card
      form(method="POST", action=`/deck/edit/${deck.id}`)

        .form-group
          label.form-label
            | Tên bộ thẻ
            span.required *
          input.form-input(
            type="text"
            name="title"
            value=deck.title
          )

        .form-group
          label.form-label Mô tả
          textarea.form-textarea(name="description")= deck.description || ''

        .form-group
          label.form-label
            | Danh mục
            span.required *
          select.form-select#categorySelect(name="category_id")
            option(value="") — Chọn danh mục —
            each cat in categories
              option(value=cat.id, selected=deck.category_id == cat.id) #{cat.name}
          .category-preview-wrap
            span#categoryBadge(class=`badge cat-${colorIdx}`)= deck.category ? deck.category.name : ''

        hr.form-divider

        .form-group
          label.form-label Trạng thái
          .radio-group
            .radio-card(class=deck.visibility === 'private' ? 'selected' : '')
              input(type="radio", name="visibility", value="private", hidden, checked=deck.visibility === 'private')
              .radio-dot
                .radio-dot-inner
              .radio-info
                .radio-title 🔒 Riêng tư
                .radio-desc Chỉ mình bạn xem và sử dụng
            .radio-card(class=deck.visibility === 'public' ? 'selected' : '')
              input(type="radio", name="visibility", value="public", hidden, checked=deck.visibility === 'public')
              .radio-dot
                .radio-dot-inner
              .radio-info
                .radio-title 🌐 Công khai
                .radio-desc Mọi người có thể tìm kiếm và tải về

        hr.form-divider

        .form-actions
          a.btn-secondary(href=`/deck/detail/${deck.id}`) Quay lại
          button.btn-primary(type="submit")
            i.fa-solid.fa-pen
            |  Cập nhật

block scripts
  script.
    const categorySelect = document.getElementById('categorySelect');
    const categoryBadge  = document.getElementById('categoryBadge');

    function updateBadge(val) {
      if (!val) { categoryBadge.className = ''; categoryBadge.textContent = ''; return; }
      const idx = parseInt(val) % 8;
      const opt = categorySelect.querySelector('option[value="' + val + '"]');
      categoryBadge.className = 'badge cat-' + idx;
      categoryBadge.textContent = opt ? opt.textContent.trim() : '';
    }

    categorySelect.addEventListener('change', function() { updateBadge(this.value); });

    document.querySelectorAll('.radio-card').forEach(function(card) {
      card.addEventListener('click', function() {
        card.closest('.radio-group').querySelectorAll('.radio-card').forEach(function(c) { c.classList.remove('selected'); });
        card.classList.add('selected');
        card.querySelector('input[type="radio"]').checked = true;
      });
    });
