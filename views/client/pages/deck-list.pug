extends ../layouts/default.pug

block main
  .db-container

    .page-header
      .page-title
        | Bộ thẻ của tôi
        span #{total} bộ thẻ
      a.btn-primary(href="/deck/create")
        i.fa-solid.fa-plus.icon-plus
        |  Tạo bộ thẻ mới

    form.filter-bar(method="GET", action="/deck")
      .search-wrap
        i.fa-solid.fa-magnifying-glass.search-icon
        input.search-input(
          type="text"
          name="search"
          placeholder="Tìm theo tên bộ thẻ..."
          value=query.search || ''
        )
      .filter-divider
      select.filter-select(name="category_id", onchange="this.form.submit()")
        option(value="") Danh mục
        each cat in categories
          option(value=cat.id, selected=query.category_id == cat.id) #{cat.name}
      select.filter-select(name="visibility", onchange="this.form.submit()")
        option(value="") Trạng thái
        option(value="public",  selected=query.visibility === 'public')  Công khai
        option(value="private", selected=query.visibility === 'private') Riêng tư
      select.filter-select(name="type", onchange="this.form.submit()")
        option(value="",        selected=!query.type || query.type === '') Tất cả
        option(value="created", selected=query.type === 'created') Đã tạo
        option(value="saved",   selected=query.type === 'saved')   Đã lưu
      select.filter-select(name="due", onchange="this.form.submit()")
        option(value="",  selected=query.due !== '1') Tất cả thẻ
        option(value="1", selected=query.due === '1') Có thẻ đến hạn
      .filter-divider
      button.btn-clear(type="button", onclick="window.location='/deck'")
        i.fa-solid.fa-xmark
        |  Xóa bộ lọc

    p.results-info
      | Hiển thị&nbsp;
      strong #{decks.length}
      | &nbsp;/&nbsp;
      strong #{total}
      |  bộ thẻ

    if decks && decks.length
      .deck-grid
        each deck in decks
          - const isOwner  = deck.owner_id == locals.user.id
          - const colorIdx = deck.category_id % 8
          .deck-card
            .deck-accent(class=`cat-${colorIdx}`)
            .deck-top
              span.badge(class=`cat-${colorIdx}`) #{deck.category ? deck.category.name : 'Chung'}
              .deck-top-right
                span.type-badge(class=isOwner ? 'type-created' : 'type-saved') #{isOwner ? 'Đã tạo' : 'Đã lưu'}
                if deck.dueCount > 0
                  span.due-count-dot #{deck.dueCount}
            .deck-name #{deck.title}
            .deck-desc #{deck.description || ''}
            .deck-meta-row
              span
                i.fa-regular.fa-clone.icon-clone
                |  #{deck.cardCount || 0} thẻ
              if deck.visibility === 'public'
                span.status-badge.status-public
                  i.fa-solid.fa-globe.icon-globe
                  |  Công khai
              else
                span.status-badge.status-private
                  i.fa-solid.fa-lock.icon-lock
                  |  Riêng tư
              if !isOwner
                span.deck-author
                  i.fa-regular.fa-user
                  |  #{deck.ownerName}
            .deck-actions
              a.btn-action.primary(href=`/deck/detail/${deck.id}`) Chi tiết
              if isOwner
                a.btn-action(href=`/deck/edit/${deck.id}`) Sửa
                button.btn-action.danger(type="button", onclick=`deleteDeck(${deck.id})`) Xóa
    else
      p.no-decks Chưa có bộ thẻ nào. Hãy tạo bộ thẻ đầu tiên!

    if totalPages > 1
      .pagination
        a.page-btn(href=`/deck?page=${currentPage - 1}`, class=currentPage <= 1 ? 'disabled' : '')
          i.fa-solid.fa-chevron-left
        each p in Array.from({length: totalPages}, (_, i) => i + 1)
          a.page-btn(href=`/deck?page=${p}`, class=p === currentPage ? 'active' : '') #{p}
        a.page-btn(href=`/deck?page=${currentPage + 1}`, class=currentPage >= totalPages ? 'disabled' : '')
          i.fa-solid.fa-chevron-right

block scripts
  script.
    function deleteDeck(id) {
      if (!confirm('Xóa bộ thẻ này?')) return;
      fetch('/deck/delete/' + id, { method: 'DELETE' })
        .then(r => r.json())
        .then(data => { if (data.code === 'success') window.location.href = data.redirect; });
    }
