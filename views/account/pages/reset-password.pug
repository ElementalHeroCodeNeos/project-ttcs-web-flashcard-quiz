extends ../layouts/account.pug

block main
  .form-account
    h2.inner-title Đặt lại mật khẩu
    p.inner-desc Vui lòng nhập mật khẩu mới để tiếp tục

    form.inner-form#reset-password-form
      .inner-group
        label.inner-label(for="password") Mật khẩu mới
        input.inner-control(
          type="password"
          name="password"
          id="password"
        )
      .inner-group
        label.inner-label(for="confirm-password") Xác nhận mật khẩu
        input.inner-control(
          type="password"
          name="confirmPassword"
          id="confirm-password"
        )
      button.inner-button Thay đổi

    .inner-more
      span Bạn đã nhớ mật khẩu?
      a(href="/login") Đăng nhập
