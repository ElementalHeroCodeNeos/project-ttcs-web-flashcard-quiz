extends ../layouts/default.pug

block main
  h1.box-title Đổi mật khẩu

  .section-8
    form#profile-change-password-form
      .inner-group
        label.inner-label(for="currentPassword") Mật khẩu hiện tại
        input(type="password" id="currentPassword" name="currentPassword")
      .inner-group
        label.inner-label(for="newPassword") Mật khẩu mới
        input(type="password" id="newPassword" name="newPassword")
      .inner-group.inner-two-col
        label.inner-label(for="confirmPassword") Xác nhận mật khẩu mới
        input(type="password" id="confirmPassword" name="confirmPassword")
      .inner-button.inner-two-col
        button Đổi mật khẩu
    .inner-back
      a(href="/admin/profile") Quay lại
